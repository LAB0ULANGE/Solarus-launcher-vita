dialog{
  id = "_treasure.dandelion_charm.1",
  text = [[
L'os d'un vieux chasseur dont le
nom s'est perdu. On dit qu'il
pratiquait l'art de l'Accélération,
une technique propre aux premiers
chasseurs.
]],
}

